# Distribution rules for `git archive` (the GitHub release tarball/zip).
#
# Principle: the released package is the plugin Moodle runs — no development,
# CI or internal-documentation machinery.

# --- Never distribute: repository and CI plumbing -------------------------
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpcs.xml          export-ignore

# --- Never distribute: internal documentation -----------------------------
# README.md and CHANGELOG.md ship (top level); working notes do not.
/docs               export-ignore

# Everything not listed above ships — including tests/, which are useful to
# maintainers, plugin review and distribution QA.
/tools              export-ignore
/makefile           export-ignore

# --- Never distribute: load-test harness ----------------------------------
# tests/load seeds courses and users, enables web services and REST and mints a
# token. A fine developer tool; it has no place on a production Moodle server.
/tests/load         export-ignore
/tests/playwright  export-ignore

# Ship English only, in the plugin and in every subplugin; the repository keeps
# every language for testing and for AMOS.
#
# Directory rules prune a whole language tree, so the release carries no empty
# folders. They need the "**/" form as well: a pattern containing a slash is
# anchored to this file, so "lang/de" alone never reached the subplugins' own
# lang directories.
lang/ar     export-ignore
**/lang/ar     export-ignore
lang/da     export-ignore
**/lang/da     export-ignore
lang/de     export-ignore
**/lang/de     export-ignore
lang/es     export-ignore
**/lang/es     export-ignore
lang/fr     export-ignore
**/lang/fr     export-ignore
lang/it     export-ignore
**/lang/it     export-ignore
lang/ja     export-ignore
**/lang/ja     export-ignore
lang/ko     export-ignore
**/lang/ko     export-ignore
lang/nl     export-ignore
**/lang/nl     export-ignore
lang/no     export-ignore
**/lang/no     export-ignore
lang/pt     export-ignore
**/lang/pt     export-ignore
lang/sv     export-ignore
**/lang/sv     export-ignore
lang/uk     export-ignore
**/lang/uk     export-ignore
lang/zh_cn  export-ignore
**/lang/zh_cn  export-ignore
lang/zh_tw  export-ignore
**/lang/zh_tw  export-ignore

# Safety net for a language added later and not listed above: these match files,
# so they cannot be pruned along with lang/en, and they keep its content out even
# if someone forgets to extend the list. Later lines win, so English is restored.
**/lang/*/*     export-ignore
**/lang/en/*    -export-ignore
