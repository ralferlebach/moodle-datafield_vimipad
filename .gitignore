# Composer / CI scratch
/vendor/
/ci/
/moodle/
# OS / editor cruft
.DS_Store
*.swp

# Load-test downloads and run artefacts. The harness itself (seed, .jmx, .k6.js,
# README) is versioned; the tools it fetches and the results it produces are not.
tests/load/apache-jmeter-*/
tests/load/k6
tests/load/*.tgz
tests/load/*.jtl
tests/load/jmeter.log
tests/load/itemids.csv
tests/load/.load-env
tests/load/.load-seed.out

# Playwright run artefacts (the suite itself is versioned; its output is not).
tests/playwright/node_modules/
tests/playwright/test-results/
tests/playwright/playwright-report/
tests/playwright/.env
tests/playwright/.env.sh
tests/playwright/blob-report/
